HTTPS=true
HOST=0.0.0.0
# The URL where your React app will be hosted in production (e.g. https://my-diary-client.vercel.app)
REACT_APP_FRONTEND_URI=http://localhost:3000
# The URL where your Node backend is hosted (e.g. https://my-backend.onrender.com). Leave empty for monolithic deployments.
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_BACKEND_PORT=5000

# Google OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Cloudinary Configuration for Secure Vault Document Storage
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
REACT_APP_CLOUDINARY_UPLOAD_PRESET=diary_vault
